# Copie para .env e preencha. O .env NÃO é versionado (item 61).

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=controladoria.saquarema.rj.gov.br,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://controladoria.saquarema.rj.gov.br,http://localhost:8800
# True quando o sistema estiver atrás de proxy com HTTPS (cookies seguros)
DJANGO_HTTPS=False
# Duração da sessão em segundos (padrão: 8 horas)
DJANGO_SESSAO_SEGUNDOS=28800
DJANGO_LOG_LEVEL=INFO

# --- Superusuário criado na primeira subida ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@saquarema.rj.gov.br
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# --- PostgreSQL ---
POSTGRES_DB=protocolo_db
POSTGRES_USER=protocolo_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Modulo LAI (aba exclusiva do administrador) ---
# Todos opcionais: sem eles valem os padroes abaixo.
# Somente superusuario acessa /lai/ (padrao True). Nao desligue em producao sem decisao da Controladoria.
LAI_SOMENTE_ADMIN=True
# Pasta de dados do modulo (documentos privados, perfil do navegador, pastas dos NUPs). No Docker: volume ./lai_dados
LAI_DATA_DIR=lai_dados
# E-mail simulado ate a TI homologar o SMTP. 1 envia de verdade.
LAI_LIVE_EMAIL=0
# LAI_SMTP_HOST=
# LAI_SMTP_PORT=587
# LAI_SMTP_USER=
# LAI_SMTP_PASSWORD=
# LAI_FROM_EMAIL=lai@saquarema.rj.gov.br
# Automacao das pastas dos NUPs (so no computador com Edge/Chrome): aponte para a pasta do ano ou do Drive para computador.
# LAI_PASTA_ANO=C:\Users\voce\Google Drive\LAI\2026
# Preencher a planilha de controle ao fim da automacao (desligado ate definir o formato).
LAI_PLANILHA_ATIVA=0